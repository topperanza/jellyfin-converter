# aider.env.example — EXAMPLE ONLY
#
# This is a sanitized template for Aider environment variables.
# Copy it to a local env file (e.g. .env.aider.local) and populate with real values.
# Source it before running Aider: source .env.aider.local
#
# DO NOT commit a populated copy with real keys.
# DO NOT set real values in this file.

# OpenAI API key (used if AIDER_MODEL targets an OpenAI model)
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# Anthropic API key (used if AIDER_MODEL targets a Claude model)
# ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE

# The model Aider should use. Examples: gpt-4o, claude-sonnet-4-6, etc.
# AIDER_MODEL=your-model-name

# Optional: suppress Aider's analytics
# AIDER_ANALYTICS=false
