# .env.example — API key placeholders for Aider
# Copy to .env and fill in real values. Never commit .env.
# See docs/agent-workflow/DUAL_AGENT_ALIGNMENT.md for Aider setup details.

# Set one of the following depending on your chosen model provider.
# Aider will use whichever key matches the --model you pass at runtime.

ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Optional: override the model at runtime instead of using --model flag.
# AIDER_MODEL=anthropic/claude-sonnet-4-6
