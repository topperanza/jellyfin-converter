# .env.example — API key placeholders for Aider and other local tooling
#
# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.
# Do not add real keys to this file.
#
# Aider supports multiple providers. Set one of the following:

# Anthropic (Claude)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI
# OPENAI_API_KEY=your-openai-api-key-here

# Optional: override the default Aider model
# AIDER_MODEL=claude-3-5-sonnet-20241022
